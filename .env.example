# GTM_MASTER_KEY enables AES-256-GCM encryption for GTM credentials stored in the database.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GTM_MASTER_KEY=<64-char hex string>

# GTM CLI: npm install -g @owntag/gtm-cli (auto-installed by the GTM Setup skill if missing)
